# NextBSD in-kernel IORegistry (K1, nextbsd#214) — appended to sys/conf/files by
# the kernel build. Source under sys/dev/iokit, laid in from the nextbsd-kernel
# src-overlay. `standard`: always compiled into the kernel (read-only newbus
# introspection; inert until queried via /dev/ioregistry or hw.iokit.registry).
# Wired by ci/prepare-src.sh, NOT in patches/series — the same reasoning as
# files.iocatalogue.
dev/iokit/iokit_registry.c	standard
# evdev -> IORegistry bridge (#335, part of #331): publishes each
# /dev/input/eventN (uinput included) as an IOHIDDevice entry, plus the one
# IOHIDSystem entry with HIDIdleTime (nextbsd-userland#239). `optional evdev`
# because it subscribes to evdev's evdev_registered / evdev_unregistering
# eventhandlers (patches/0068), calls evdev_foreach() and sets
# evdev_user_input_hook (patches/0093).
dev/iokit/iokit_hid.c		optional evdev
# USB -> IORegistry bridge (#391): publishes every USB device, claimed or
# not, as an IOUSBHostDevice entry. `optional usb` because it subscribes to
# the USB stack's usb_dev_attached / usb_dev_detaching eventhandlers
# (patches/0087) and reads struct usb_device.
dev/iokit/iokit_usb.c		optional usb
# DRM -> IORegistry bridge (#338): turns drm-kmod's drm_connector_hotplug
# eventhandler (graphics/drm-kmod-patches in nextbsd-kernel-extensions-graphics) into
# kIOMessageServicePropertyChange interest messages on the GPU's entry.
# `standard`: drm.ko is a kext that invokes the eventhandler by name, so
# nothing here links against it.
dev/iokit/iokit_drm.c		standard
# ACPI battery -> IORegistry bridge (nextbsd-kernel#244): publishes each ACPI
# battery as an IOPMPowerSource entry with Apple's power-source keys, refreshed
# from the acpi_cmbat_event (patches/0088) and acpi_acad_event eventhandlers.
# `optional acpi` because it calls the ACPI battery and AC adapter drivers
# (ACPI_BATT_GET_STATUS/INFO, acpi_acad_get_acline); NEXTBSD-RPI5 has no acpi.
dev/iokit/iokit_powersource.c	optional acpi
# In-kernel IOPMrootDomain (#243): the IOPMrootDomain entry, the
# kIOAppPowerStateInterest sleep/wake fan-out with acknowledgements, and
# /dev/iopmroot. `standard`: ACPI's lid and button eventhandlers and its
# sleep listener are guarded by DEV_ACPI inside, so configs without acpi
# still publish the entry (IOSleepSupported false).
dev/iokit/iokit_pmroot.c	standard
