# files.compat_linux.arm64 -- static Linuxulator (linux64) for NextBSD on arm64.
#
# Appended to /usr/src/sys/conf/files.arm64 by the kernel workflow, the same
# mechanism files.compat_linux uses for files.amd64.
#
# WHY A SEPARATE FILE
# files.compat_linux is amd64-specific in two ways that cannot be expressed in
# one fragment: it names amd64/linux/* for the machine-dependent half, and it
# pulls in x86/linux/* (linux_x86.c, linux_vdso_selector_x86.c,
# linux_dummy_x86.c), which do not exist on arm64 and are not needed there.
# sys/modules/linux64/Makefile and sys/modules/linux_common/Makefile guard both
# with `.if ${MACHINE_CPUARCH} == "amd64"'; config(8) has no equivalent, so the
# split is per-file instead.
#
# Upstream ships the 64-bit Linux ABI only as sys/modules/linux64, and
# sys/conf/files.arm64 carries no linux entries at all (verified against
# releng/15.1). NextBSD ships no /boot/kernel .ko tree and no kld tooling
# (kldload/kldstat/kldunload are superseded by kext*), so a module is not
# loadable here -- compiling in is the only route, exactly as on amd64.
#
# Registration works statically: arm64/linux/linux_sysvec.c uses
# DECLARE_MODULE_TIED(linux64elf, ..., SI_SUB_EXEC, SI_ORDER_ANY) -- the same
# name and SYSINIT point as amd64 -- and inserts the ELF brand entries from its
# MOD_LOAD handler, which the module system fires for statically linked code.

# --- generated artefacts ----------------------------------------------------
# Same dependency chain as amd64, but the aarch64 VDSO flags differ. From
# sys/modules/linux64/Makefile:
#
#   .elif ${MACHINE_CPUARCH} == "aarch64"
#   # The Linux uses tiny memory model, but our ld does not know about
#   # some of relocation types which is generated by cc
#   VDSOFLAGS=-mgeneral-regs-only -mcmodel=small -ffixed-x18
#
# so -mgeneral-regs-only and -ffixed-x18 replace amd64's -msoft-float. x18 is
# the platform register on arm64 and must stay fixed in vDSO code. VDSODEPS is
# empty here: linux_vdso_gettc_x86.inc is x86-only.

linux_genassym.o		optional compat_linux			\
	dependency	"$S/arm64/linux/linux_genassym.c offset.inc"	\
	compile-with	"${CC} -c ${NOSAN_CFLAGS:N-flto*:N-fno-common} -fcommon $S/arm64/linux/linux_genassym.c" \
	no-obj no-implicit-rule						\
	clean		"linux_genassym.o"

linux_assym.h			optional compat_linux			\
	dependency	"$S/kern/genassym.sh linux_genassym.o"		\
	compile-with	"sh $S/kern/genassym.sh linux_genassym.o > ${.TARGET}" \
	no-obj no-implicit-rule before-depend				\
	clean		"linux_assym.h"

linux_locore.o			optional compat_linux			\
	dependency	"linux_assym.h assym.inc $S/arm64/linux/linux_locore.asm" \
	compile-with	"${CC} -c -x assembler-with-cpp -DLOCORE -fPIC -pipe -O2 -Werror -mgeneral-regs-only -mcmodel=small -ffixed-x18 -nostdinc -fasynchronous-unwind-tables -fno-omit-frame-pointer -foptimize-sibling-calls -fno-stack-protector -I. -I$S -I$S/../include $S/arm64/linux/linux_locore.asm -o ${.TARGET}" \
	no-obj no-implicit-rule						\
	clean		"linux_locore.o"

linux_vdso_gtod.o		optional compat_linux			\
	dependency	"$S/arm64/linux/linux_vdso_gtod.c $S/compat/linux/linux_vdso_gtod.inc" \
	compile-with	"${CC} -c -fPIC -pipe -O2 -Werror -mgeneral-regs-only -mcmodel=small -ffixed-x18 -nostdinc -fasynchronous-unwind-tables -fno-omit-frame-pointer -foptimize-sibling-calls -fno-stack-protector -I. -I$S -I$S/../include $S/arm64/linux/linux_vdso_gtod.c -o ${.TARGET}" \
	no-obj no-implicit-rule						\
	clean		"linux_vdso_gtod.o"

linux_vdso.so.o			optional compat_linux			\
	dependency	"linux_locore.o linux_vdso_gtod.o"		\
	compile-with	"${LD} --shared --eh-frame-hdr -soname=linux-vdso.so.1 --no-undefined --hash-style=both -warn-common -nostdlib --strip-debug -s --build-id=sha1 -Bsymbolic -T$S/arm64/linux/linux_vdso.lds.s -o ${.TARGET} linux_locore.o linux_vdso_gtod.o" \
	no-obj no-implicit-rule						\
	clean		"linux_vdso.so.o"

# --- linux_common (shared ABI support; MODULE_DEPEND of linux64elf) ---------
# Identical to amd64 minus x86/linux/linux_x86.c and
# x86/linux/linux_vdso_selector_x86.c, which linux_common's Makefile adds only
# under .if ${MACHINE_CPUARCH} == "amd64".
compat/linux/linux_common.c	optional compat_linux
compat/linux/linux_mib.c	optional compat_linux
compat/linux/linux_mmap.c	optional compat_linux
compat/linux/linux_util.c	optional compat_linux
compat/linux/linux_emul.c	optional compat_linux
compat/linux/linux_dummy.c	optional compat_linux
compat/linux/linux_errno.c	optional compat_linux
compat/linux/linux_netlink.c	optional compat_linux
compat/linux/linux.c		optional compat_linux

# --- linux64: machine-dependent (sys/arm64/linux) ---------------------------
# No linux_dummy_x86.c counterpart: that file is x86-only.
arm64/linux/linux_dummy_machdep.c	optional compat_linux
arm64/linux/linux_machdep.c	optional compat_linux
arm64/linux/linux_syscalls.c	optional compat_linux
arm64/linux/linux_sysent.c	optional compat_linux
arm64/linux/linux_sysvec.c	optional compat_linux
arm64/linux/linux_support.S	optional compat_linux			\
	dependency	"linux_assym.h assym.inc"

# --- linux64: machine-independent ------------------------------------------
# linux_elf.c is #include'd by linux_elf64.c (__ELF_WORD_SIZE), not built alone.
compat/linux/linux_elf64.c	optional compat_linux
compat/linux/linux_event.c	optional compat_linux
compat/linux/linux_file.c	optional compat_linux
compat/linux/linux_fork.c	optional compat_linux
compat/linux/linux_futex.c	optional compat_linux
compat/linux/linux_getcwd.c	optional compat_linux
compat/linux/linux_ioctl.c	optional compat_linux
compat/linux/linux_ipc.c	optional compat_linux
compat/linux/linux_misc.c	optional compat_linux
compat/linux/linux_ptrace.c	optional compat_linux
compat/linux/linux_rseq.c	optional compat_linux
compat/linux/linux_signal.c	optional compat_linux
compat/linux/linux_socket.c	optional compat_linux
compat/linux/linux_stats.c	optional compat_linux
compat/linux/linux_sysctl.c	optional compat_linux
compat/linux/linux_time.c	optional compat_linux
compat/linux/linux_timer.c	optional compat_linux
compat/linux/linux_vdso.c	optional compat_linux
compat/linux/linux_xattr.c	optional compat_linux
compat/linux/linux_vdso_inc.S	optional compat_linux			\
	dependency	"linux_vdso.so.o"

# --- linprocfs / linsysfs ---------------------------------------------------
# Both are MI; the entries are duplicated here rather than shared because
# config(8) reads one files.<arch> per target and the amd64 copy lives in
# files.compat_linux. /proc has to exist even with no Linux base installed --
# the AppImage runtime resolves its own path via /proc/self/exe.
compat/linprocfs/linprocfs.c	optional linprocfs
compat/linsysfs/linsysfs.c	optional linsysfs
compat/linsysfs/linsysfs_net.c	optional linsysfs
