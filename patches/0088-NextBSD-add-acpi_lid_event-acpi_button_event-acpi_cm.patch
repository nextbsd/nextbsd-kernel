From 2739429d9e421125b5cb8fe838dfb38121f9a369 Mon Sep 17 00:00:00 2001
From: pkgdemon <pkgdemonteam@gmail.com>
Date: Mon, 2 Nov 2026 21:05:45 -0600
Subject: [PATCH 88/89] NextBSD: add
 acpi_lid_event/acpi_button_event/acpi_cmbat_event eventhandlers

Lid, button and battery events reach userland only as devctl events
from acpi_UserNotify(), and NextBSD has no consumer for /dev/devctl
(no devd).  Only the AC adapter has an in-kernel hook, acpi_acad_event,
and acpi_lid reuses acpi_sleep_event/acpi_wakeup_event with the lid
sleep state, which a listener cannot tell apart from a button.

Invoke three new eventhandlers next to the existing acpi_UserNotify()
calls, declared in acpivar.h beside acpi_acad_event:

- acpi_lid_event(open) in acpi_lid_status_update(), where the "Lid"
  devctl event is sent, so a lid change across a sleep is reported too
- acpi_button_event(type) in acpi_button_notify_sleep(), for a
  control-method power or sleep button press; the button type enum
  moves from acpi_button.c to acpivar.h for consumers
- acpi_cmbat_event(dev, notify) in acpi_cmbat_notify_handler()

The devctl events are unchanged.  NextBSD's in-kernel IOPMrootDomain
consumes these.  The eventhandlers are looked up by name, so with
nothing subscribed the invokes are no-ops.

Carried out-of-tree for NextBSD.
---
 sys/dev/acpica/acpi_button.c |  4 +++-
 sys/dev/acpica/acpi_cmbat.c  |  2 ++
 sys/dev/acpica/acpi_lid.c    |  1 +
 sys/dev/acpica/acpivar.h     | 36 ++++++++++++++++++++++++++++++++++++
 4 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/sys/dev/acpica/acpi_button.c b/sys/dev/acpica/acpi_button.c
index de6fe226..3bacf533 100644
--- a/sys/dev/acpica/acpi_button.c
+++ b/sys/dev/acpica/acpi_button.c
@@ -33,6 +33,7 @@
 #include <sys/kernel.h>
 #include <sys/module.h>
 #include <sys/bus.h>
+#include <sys/eventhandler.h>
 
 #include <contrib/dev/acpica/include/acpi.h>
 #include <contrib/dev/acpica/include/accommon.h>
@@ -51,7 +52,7 @@ ACPI_MODULE_NAME("BUTTON")
 struct acpi_button_softc {
     device_t	button_dev;
     ACPI_HANDLE	button_handle;
-    enum { ACPI_POWER_BUTTON, ACPI_SLEEP_BUTTON } button_type;
+    enum acpi_button_type button_type;
     bool	fixed;
 #ifdef EVDEV_SUPPORT
     struct evdev_dev *button_evdev;
@@ -217,6 +218,7 @@ acpi_button_notify_sleep(void *arg)
 	return_VOID;
 
     acpi_UserNotify("Button", sc->button_handle, sc->button_type);
+    EVENTHANDLER_INVOKE(acpi_button_event, sc->button_type);
 
     switch (sc->button_type) {
     case ACPI_POWER_BUTTON:
diff --git a/sys/dev/acpica/acpi_cmbat.c b/sys/dev/acpica/acpi_cmbat.c
index 35032244..6af148af 100644
--- a/sys/dev/acpica/acpi_cmbat.c
+++ b/sys/dev/acpica/acpi_cmbat.c
@@ -33,6 +33,7 @@
 #include <sys/kernel.h>
 #include <sys/module.h>
 #include <sys/bus.h>
+#include <sys/eventhandler.h>
 #include <sys/ioccom.h>
 
 #include <machine/bus.h>
@@ -213,6 +214,7 @@ acpi_cmbat_notify_handler(ACPI_HANDLE h, UINT32 notify, void *context)
     }
 
     acpi_UserNotify("CMBAT", h, notify);
+    EVENTHANDLER_INVOKE(acpi_cmbat_event, dev, notify);
 }
 
 static int
diff --git a/sys/dev/acpica/acpi_lid.c b/sys/dev/acpica/acpi_lid.c
index 142791f7..528718a0 100644
--- a/sys/dev/acpica/acpi_lid.c
+++ b/sys/dev/acpica/acpi_lid.c
@@ -116,6 +116,7 @@ acpi_lid_status_update(struct acpi_lid_softc *sc)
 
 	/* Send notification via devd */
 	acpi_UserNotify("Lid", sc->lid_handle, sc->lid_status);
+	EVENTHANDLER_INVOKE(acpi_lid_event, sc->lid_status);
 
 #ifdef EVDEV_SUPPORT
 	/* Notify evdev about lid status */
diff --git a/sys/dev/acpica/acpivar.h b/sys/dev/acpica/acpivar.h
index ea416402..973f874b 100644
--- a/sys/dev/acpica/acpivar.h
+++ b/sys/dev/acpica/acpivar.h
@@ -488,6 +488,42 @@ EVENTHANDLER_DECLARE(acpi_wakeup_event, acpi_event_handler_t);
 EVENTHANDLER_DECLARE(acpi_acad_event, acpi_event_handler_t);
 EVENTHANDLER_DECLARE(acpi_video_event, acpi_event_handler_t);
 
+/*
+ * Lid, button and battery events for in-kernel consumers (NextBSD's IOKit
+ * power bridge), invoked next to the matching acpi_UserNotify() devctl
+ * event, so nothing has to read /dev/devctl.
+ *
+ * acpi_lid_event(open): the lid changed state; 1 open, 0 closed.  Also
+ *   invoked when the lid driver attaches and when it resumes, if the
+ *   state differs from the last one reported.
+ * acpi_button_event(type): a power or sleep button was pressed;
+ *   ACPI_POWER_BUTTON or ACPI_SLEEP_BUTTON.  Not invoked for the
+ *   "pressed for wakeup" notify, which is not a press.
+ * acpi_cmbat_event(dev, notify): a control method battery's notify, as
+ *   passed to devctl: ACPI_CMBAT_NOTIFY_BST (0x80, status changed),
+ *   ACPI_CMBAT_NOTIFY_BIX (0x81, information changed), or a bus or device
+ *   check (0x00, 0x01; battery inserted or removed).  dev is the
+ *   acpi_cmbat device.
+ * AC adapter changes use acpi_acad_event above.
+ *
+ * Handlers run in the ACPI task thread (or a driver's attach or resume
+ * method), never in interrupt context, so they may take sleepable locks,
+ * but they should not block for long.
+ */
+enum acpi_button_type {
+	ACPI_POWER_BUTTON,
+	ACPI_SLEEP_BUTTON
+};
+
+#define	ACPI_CMBAT_NOTIFY_BST	0x80
+#define	ACPI_CMBAT_NOTIFY_BIX	0x81
+
+typedef void (*acpi_cmbat_event_handler_t)(void *, device_t, int);
+
+EVENTHANDLER_DECLARE(acpi_lid_event, acpi_event_handler_t);
+EVENTHANDLER_DECLARE(acpi_button_event, acpi_event_handler_t);
+EVENTHANDLER_DECLARE(acpi_cmbat_event, acpi_cmbat_event_handler_t);
+
 /* Device power control. */
 ACPI_STATUS	acpi_pwr_wake_enable(ACPI_HANDLE consumer, int enable);
 ACPI_STATUS	acpi_pwr_switch_consumer(ACPI_HANDLE consumer, int state);
