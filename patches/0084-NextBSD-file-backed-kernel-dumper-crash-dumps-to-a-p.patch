+/*
+ * File-backed kernel dumper (NextBSD).
+ *
+ * Crash dumps go to a preallocated regular file, such as
+ * /private/var/vm/kernelcore, instead of a swap or dump partition.  The
+ * design follows xnu's kern_open_file_for_direct_io(): the file is pinned
+ * and its blocks are resolved once, while the system is healthy, into a
+ * table of physical extents on the disk under the filesystem.  At panic
+ * time the dump is written through that table by the disk's own polled
+ * dump routine, with the filesystem, the buffer cache and GEOM's threads
+ * all off the path.
+ *
+ * Pinning is the swap-file machinery's (vn_extmap_pin(), swap_pager.c):
+ * the file is synced and invalidated, must have no holes, and carries
+ * VIRF_SWAP, so the filesystem refuses to write, truncate, unlink or
+ * rename it until it is unpinned.
+ *
+ * The disk's dump routine comes from GEOM::kerneldump, asked of the
+ * filesystem's own g_vfs consumer: it returns the leaf dumperinfo with
+ * the partition's offset already added, as it does for dumpon(8) on a
+ * partition.  g_part allows that request on a UFS partition when it comes
+ * from a filesystem's consumer.
+ *
+ * The registered dumper is an ordinary dumperinfo: mediaoffset 0,
+ * mediasize the file's whole pages, a 4096-byte block (savecore(8) reads a
+ * regular file in 4096-byte sectors) and the leaf's maximum I/O size.
+ * dumpfile_write() maps each write through the extent table, splitting it
+ * at extent boundaries, and hands the pieces to the leaf at
+ * leaf.mediaoffset + physical offset.  The final (NULL, 0, 0) flush goes
+ * to the leaf as is.  EKCD encryption and gzip/zstd compression sit above
+ * dump_write() and need nothing here.
+ *
+ * dumpon(8) reaches dumpfile_ioctl() with DIOCSKERNELDUMP on the open file
+ * (vn_ioctl()).  The dumper is named by the file's absolute path, so
+ * "dumpon -l" prints a name that savecore(8) and "dumpon -r" accept.  A
+ * file may back several dumper configurations (say, with and without
+ * compression); it stays pinned while any of them is registered.  When the
+ * last one is removed -- "dumpon -r", "dumpon off", or a failed insert --
+ * dumper_destroy() calls dumpfile_dumper_destroyed() and a task unpins
+ * the file.  dounmount() calls dumpfile_unmount(), which removes the
+ * dumpers of files on that mount and unpins them before the filesystem
+ * goes away.
+ *
+ * Only UFS is supported, like the swap-file backend.  ZFS needs its own
+ * dump path and is not handled here.
+ */
+
+/*
+ * The messages come from the same pinned-file machinery as swap files',
+ * so they share the swap category rather than adding one that libc's
+ * table does not know.
+ */
+#define	EXTERR_CATEGORY		EXTERR_CAT_SWAP
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/exterrvar.h>
+#include <sys/fcntl.h>
+#include <sys/kerneldump.h>
+#include <sys/kernel.h>
+#include <sys/limits.h>
+#include <sys/lock.h>
+#include <sys/malloc.h>
+#include <sys/mount.h>
+#include <sys/mutex.h>
+#include <sys/priv.h>
+#include <sys/proc.h>
+#include <sys/queue.h>
+#include <sys/sx.h>
+#include <sys/taskqueue.h>
+#include <sys/vnode.h>
+
+#include <vm/vm.h>
+#include <vm/vm_param.h>
+#include <vm/swap_pager.h>
+
+#include <geom/geom.h>
+
+/* savecore(8) reads a dump file in sectors of this size. */
+#define	DUMPFILE_BLKSZ		4096
+CTASSERT(PAGE_SIZE % DUMPFILE_BLKSZ == 0);
+
+static MALLOC_DEFINE(M_DUMPFILE, "dumpfile", "File-backed kernel dumper");
+
+struct dumpfile {
+	LIST_ENTRY(dumpfile) df_link;	/* dumpfiles, while listed */
+	struct vn_extmap df_map;
+	struct task	df_task;	/* unpins and frees, at refs 0 */
+	u_int		df_refs;	/* dumper configs, under dumpfile_mtx */
+	bool		df_listed;	/* under dumpfile_sx */
+	volatile bool	df_pinned;	/* under dumpfile_sx; read at dump */
+
+	/* The leaf dump routine GEOM::kerneldump returned. */
+	dumper_t	*df_dumper;
+	void		*df_priv;
+	u_int		df_blocksize;
+	u_int		df_maxiosize;
+	off_t		df_mediaoffset;
+	off_t		df_mediasize;
+
+	char		*df_name;	/* absolute path; the dumper's name */
+};
+
+static LIST_HEAD(, dumpfile) dumpfiles = LIST_HEAD_INITIALIZER(dumpfiles);
+static struct sx dumpfile_sx;
+static struct mtx dumpfile_mtx;
+SX_SYSINIT(dumpfile_sx, &dumpfile_sx, "dumpfile");
+MTX_SYSINIT(dumpfile_mtx, &dumpfile_mtx, "dumpfile refs", MTX_DEF);
+
+static dumper_t dumpfile_write;
+static task_fn_t dumpfile_task;
+
+/*
+ * The dumper.  Runs at panic time with the scheduler stopped: no locks,
+ * no allocation, only arithmetic and the leaf's polled dump routine.
+ * dump_write() has already checked that the write is block-aligned and
+ * inside [0, mediasize).
+ */
+static int
+dumpfile_write(void *priv, void *virtual, off_t offset, size_t length)
+{
+	struct dumpfile *df;
+	const struct vn_extent *ve;
+	vm_pindex_t lpage;
+	off_t end;
+	size_t n;
+	int error;
+
+	df = priv;
+	if (!df->df_pinned)
+		return (ENXIO);
+	if (length == 0)
+		return (df->df_dumper(df->df_priv, virtual, offset, 0));
+
+	while (length > 0) {
+		lpage = atop(offset);
+		if (offset < 0 || lpage >= df->df_map.em_npages)
+			return (ENOSPC);
+		ve = vn_extmap_lookup(&df->df_map, lpage);
+		end = ptoa(ve->ve_lpage + ve->ve_npages);
+		n = MIN(length, (size_t)(end - offset));
+		error = df->df_dumper(df->df_priv, virtual,
+		    df->df_mediaoffset + ve->ve_poff +
+		    (offset - ptoa(ve->ve_lpage)), n);
+		if (error != 0)
+			return (error);
+		offset += n;
+		length -= n;
+		if (virtual != NULL)
+			virtual = (char *)virtual + n;
+	}
+	return (0);
+}
+
+static struct dumpfile *
+dumpfile_lookup(struct vnode *vp)
+{
+	struct dumpfile *df;
+
+	sx_assert(&dumpfile_sx, SA_LOCKED);
+	LIST_FOREACH(df, &dumpfiles, df_link) {
+		if (df->df_map.em_vp == vp)
+			return (df);
+	}
+	return (NULL);
+}
+
+/*
+ * Ask GEOM for the dump routine of the disk under the filesystem and check
+ * that every extent of the file can be written through it.
+ */
+static int
+dumpfile_leaf(struct dumpfile *df)
+{
+	struct g_kerneldump kd;
+	const struct vn_extent *ve;
+	u_int i;
+	int error, len;
+
+	len = sizeof(kd);
+	memset(&kd, 0, len);
+	kd.offset = 0;
+	kd.length = OFF_MAX;
+	error = g_io_getattr("GEOM::kerneldump", df->df_map.em_cp, &len, &kd);
+	if (error != 0)
+		return (EXTERROR(error,
+		    "the disk under this file cannot take kernel dumps"));
+	if (kd.di.dumper == NULL || kd.di.dumper_start != NULL ||
+	    kd.di.dumper_hdr != NULL)
+		return (EXTERROR(EOPNOTSUPP,
+		    "the disk under this file has an unsupported dump routine"));
+	if (kd.di.blocksize == 0 || DUMPFILE_BLKSZ % kd.di.blocksize != 0 ||
+	    kd.di.mediaoffset % kd.di.blocksize != 0)
+		return (EXTERROR(EINVAL,
+		    "the dump block size is not a multiple of the disk's"));
+	if (kd.di.maxiosize < DUMPFILE_BLKSZ)
+		return (EXTERROR(EINVAL, "the disk's dump I/O size is too small"));
+	for (i = 0; i < df->df_map.em_next; i++) {
+		ve = &df->df_map.em_ext[i];
+		if (ve->ve_poff + (off_t)ptoa(ve->ve_npages) >
+		    kd.di.mediasize)
+			return (EXTERROR(EINVAL,
+			    "file extent outside the dump device"));
+	}
+	df->df_dumper = kd.di.dumper;
+	df->df_priv = kd.di.priv;
+	df->df_blocksize = kd.di.blocksize;
+	df->df_maxiosize = rounddown(kd.di.maxiosize, DUMPFILE_BLKSZ);
+	df->df_mediaoffset = kd.di.mediaoffset;
+	df->df_mediasize = kd.di.mediasize;
+	return (0);
+}
+
+/*
+ * Pin vp for dumping and list it.  Called with dumpfile_sx held and the
+ * mount busied; vp is unlocked.
+ */
+static int
+dumpfile_create(struct thread *td, struct vnode *vp, struct dumpfile **dfp)
+{
+	struct dumpfile *df;
+	char *fullpath, *freepath;
+	int error;
+
+	sx_assert(&dumpfile_sx, SA_XLOCKED);
+	freepath = NULL;
+	error = vn_fullpath_global(vp, &fullpath, &freepath);
+	if (error != 0)
+		return (EXTERROR(error, "cannot resolve the file's path"));
+
+	df = malloc(sizeof(*df), M_DUMPFILE, M_WAITOK | M_ZERO);
+	df->df_name = strdup(fullpath, M_DUMPFILE);
+	free(freepath, M_TEMP);
+	TASK_INIT(&df->df_task, 0, dumpfile_task, df);
+
+	vn_lock(vp, LK_EXCLUSIVE | LK_RETRY);
+	error = vn_extmap_pin(td, vp, &df->df_map);
+	if (error != 0) {
+		VOP_UNLOCK(vp);
+		goto fail;
+	}
+	error = dumpfile_leaf(df);
+	if (error != 0) {
+		vn_extmap_unpin(td, &df->df_map);
+		VOP_UNLOCK(vp);
+		goto fail;
+	}
+	VOP_UNLOCK(vp);
+
+	/* The pin keeps its own reference; dumpon(8)'s fd goes away. */
+	vref(vp);
+	df->df_pinned = true;
+	df->df_listed = true;
+	LIST_INSERT_HEAD(&dumpfiles, df, df_link);
+	*dfp = df;
+	return (0);
+fail:
+	free(df->df_name, M_DUMPFILE);
+	free(df, M_DUMPFILE);
+	return (error);
+}
+
+/* Unpin and unlist df.  dumpfile_sx is held exclusively. */
+static void
+dumpfile_unpin(struct thread *td, struct dumpfile *df)
+{
+	struct vnode *vp;
+
+	sx_assert(&dumpfile_sx, SA_XLOCKED);
+	if (df->df_listed) {
+		LIST_REMOVE(df, df_link);
+		df->df_listed = false;
+	}
+	if (!df->df_pinned)
+		return;
+	df->df_pinned = false;
+	vp = df->df_map.em_vp;
+	vn_lock(vp, LK_EXCLUSIVE | LK_RETRY);
+	vn_extmap_unpin(td, &df->df_map);
+	vput(vp);
+}
+
+/*
+ * The last dumper configuration of df is gone: unpin the file and free df,
+ * unless a new configuration took it again first.
+ */
+static void
+dumpfile_task(void *arg, int pending __unused)
+{
+	struct dumpfile *df;
+	u_int refs;
+
+	df = arg;
+	sx_xlock(&dumpfile_sx);
+	mtx_lock(&dumpfile_mtx);
+	refs = df->df_refs;
+	mtx_unlock(&dumpfile_mtx);
+	if (refs != 0) {
+		sx_xunlock(&dumpfile_sx);
+		return;
+	}
+	dumpfile_unpin(curthread, df);
+	sx_xunlock(&dumpfile_sx);
+
+	/*
+	 * Unlisted with no references, df can be queued no more, but a
+	 * second enqueue may have landed while this one ran.
+	 */
+	taskqueue_cancel(taskqueue_thread, &df->df_task, NULL);
+	free(df->df_name, M_DUMPFILE);
+	free(df, M_DUMPFILE);
+}
+
+/*
+ * Called by dumper_destroy() for every dumperinfo it frees, under the
+ * dumper list mutex.  Each copy of a file dumper holds one reference on
+ * its dumpfile; the last one queues the unpin.
+ */
+void
+dumpfile_dumper_destroyed(struct dumperinfo *di)
+{
+	struct dumpfile *df;
+
+	if (di->dumper != dumpfile_write)
+		return;
+	df = di->priv;
+	mtx_lock(&dumpfile_mtx);
+	KASSERT(df->df_refs > 0, ("dumpfile %p: no references", df));
+	if (--df->df_refs == 0)
+		taskqueue_enqueue(taskqueue_thread, &df->df_task);
+	mtx_unlock(&dumpfile_mtx);
+}
+
+static int
+dumpfile_insert(struct thread *td, struct vnode *vp,
+    struct diocskerneldump_arg *kda)
+{
+	struct dumperinfo di;
+	struct dumpfile *df;
+	struct mount *mp;
+	int error;
+
+	if (!vn_extmap_supported(vp))
+		return (EXTERROR(EOPNOTSUPP,
+		    "kernel dumps to a file need a file on UFS"));
+	vn_lock(vp, LK_SHARED | LK_RETRY);
+	error = VOP_ACCESS(vp, VREAD | VWRITE, td->td_ucred, td);
+	VOP_UNLOCK(vp);
+	if (error != 0)
+		return (error);
+
+	/*
+	 * Keep the filesystem mounted until the dumper is registered and
+	 * listed: an unmount waits for this, then finds it in
+	 * dumpfile_unmount().
+	 */
+	mp = vp->v_mount;
+	if (mp == NULL || vfs_busy(mp, MBF_NOWAIT) != 0)
+		return (EBUSY);
+	sx_xlock(&dumpfile_sx);
+	df = dumpfile_lookup(vp);
+	if (df == NULL) {
+		error = dumpfile_create(td, vp, &df);
+		if (error != 0)
+			goto out;
+	}
+
+	mtx_lock(&dumpfile_mtx);
+	df->df_refs++;
+	mtx_unlock(&dumpfile_mtx);
+
+	bzero(&di, sizeof(di));
+	di.dumper = dumpfile_write;
+	di.priv = df;
+	di.blocksize = DUMPFILE_BLKSZ;
+	di.maxiosize = df->df_maxiosize;
+	di.mediaoffset = 0;
+	di.mediasize = ptoa(df->df_map.em_npages);
+
+	/*
+	 * Every copy dumper_insert() makes holds the reference just taken.
+	 * If it fails after making one, dumper_destroy() has already
+	 * dropped it, and a file pinned for this call alone is unpinned by
+	 * the task.  The privilege check that dumper_insert() makes before
+	 * copying was passed in dumpfile_ioctl().
+	 */
+	error = dumper_insert(&di, df->df_name, kda);
+	if (error == 0)
+		printf("kernel dumps on %s\n", df->df_name);
+out:
+	sx_xunlock(&dumpfile_sx);
+	vfs_unbusy(mp);
+	return (error);
+}
+
+/*
+ * DIOCSKERNELDUMP on an open regular file, from vn_ioctl().
+ */
+int
+dumpfile_ioctl(struct vnode *vp, struct diocskerneldump_arg *kda,
+    struct thread *td)
+{
+	struct dumpfile *df;
+	uint8_t *encryptedkey;
+	int error;
+
+	error = priv_check(td, PRIV_SETDUMPER);
+	if (error != 0)
+		goto out;
+
+	switch (kda->kda_index) {
+	case KDA_REMOVE_ALL:
+		error = dumper_remove(NULL, kda);
+		goto out;
+	case KDA_REMOVE:
+	case KDA_REMOVE_DEV:
+		/* Held across dumper_remove(): the task may free df. */
+		sx_xlock(&dumpfile_sx);
+		df = dumpfile_lookup(vp);
+		if (df == NULL)
+			error = kda->kda_index == KDA_REMOVE ? ENOENT : 0;
+		else
+			error = dumper_remove(df->df_name, kda);
+		sx_xunlock(&dumpfile_sx);
+		goto out;
+	}
+
+	encryptedkey = NULL;
+	if (kda->kda_encryption != KERNELDUMP_ENC_NONE) {
+		if (kda->kda_encryptedkeysize == 0 ||
+		    kda->kda_encryptedkeysize > KERNELDUMP_ENCKEY_MAX_SIZE) {
+			error = EINVAL;
+			goto out;
+		}
+		encryptedkey = malloc(kda->kda_encryptedkeysize, M_TEMP,
+		    M_WAITOK);
+		error = copyin(kda->kda_encryptedkey, encryptedkey,
+		    kda->kda_encryptedkeysize);
+	}
+	if (error == 0) {
+		kda->kda_encryptedkey = encryptedkey;
+		error = dumpfile_insert(td, vp, kda);
+	}
+	zfree(encryptedkey, M_TEMP);
+out:
+	explicit_bzero(kda, sizeof(*kda));
+	return (error);
+}
+
+/*
+ * dounmount(): remove the dumpers of files on mp and unpin them before the
+ * filesystem goes away.  Fails, and so fails the unmount, only if the
+ * caller may not change the dump configuration.
+ */
+int
+dumpfile_unmount(struct mount *mp)
+{
+	struct diocskerneldump_arg kda;
+	struct dumpfile *df, *tdf;
+	int error;
+
+	error = 0;
+	sx_xlock(&dumpfile_sx);
+	LIST_FOREACH_SAFE(df, &dumpfiles, df_link, tdf) {
+		if (df->df_map.em_mp != mp)
+			continue;
+		bzero(&kda, sizeof(kda));
+		kda.kda_index = KDA_REMOVE_DEV;
+		error = dumper_remove(df->df_name, &kda);
+		if (error != 0)
+			break;
+		printf("kernel dumps on %s removed at unmount\n",
+		    df->df_name);
+		/* The task frees df once it sees it unlisted. */
+		dumpfile_unpin(curthread, df);
+	}
+	sx_xunlock(&dumpfile_sx);
+	return (error != 0 ? EBUSY : 0);
+}
diff --git a/sys/kern/kern_shutdown.c b/sys/kern/kern_shutdown.c
index 38a98010..89500436 100644
--- a/sys/kern/kern_shutdown.c
+++ b/sys/kern/kern_shutdown.c
@@ -1229,6 +1229,8 @@ dumper_destroy(struct dumperinfo *di)
 	if (di == NULL)
 		return;
 
+	/* A file dumper's copy holds a reference on its pinned file. */
+	dumpfile_dumper_destroyed(di);
 	zfree(di->blockbuf, M_DUMPER);
 	kerneldumpcomp_destroy(di);
