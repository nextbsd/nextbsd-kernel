     struct ucred *cred, vm_ooffset_t size, vm_ooffset_t offset);
+
+/*
+ * Pinned-file extent maps (NextBSD): a regular file whose blocks the
+ * kernel writes directly, used by swap files and by the file-backed
+ * kernel dumper.  See vn_extmap_pin() in swap_pager.c.
+ */
+struct g_consumer;
+struct vnode;
+
+struct vn_extent {
+	vm_pindex_t	ve_lpage;	/* first page within the file */
+	vm_pindex_t	ve_npages;	/* length in pages */
+	off_t		ve_poff;	/* byte offset on the provider */
+};
+
+struct vn_extmap {
+	struct vnode	*em_vp;
+	struct mount	*em_mp;
+	struct g_consumer *em_cp;	/* the filesystem's g_vfs consumer */
+	struct vn_extent *em_ext;
+	u_int		em_next;
+	vm_pindex_t	em_npages;	/* pages mapped, from page 0 */
+};
+
+bool vn_extmap_supported(struct vnode *vp);
+int vn_extmap_pin(struct thread *td, struct vnode *vp, struct vn_extmap *em);
+void vn_extmap_unpin(struct thread *td, struct vn_extmap *em);
+const struct vn_extent *vn_extmap_lookup(const struct vn_extmap *em,
+    vm_pindex_t lpage);
 #endif				/* _KERNEL */
 #endif				/* _VM_SWAP_PAGER_H_ */
